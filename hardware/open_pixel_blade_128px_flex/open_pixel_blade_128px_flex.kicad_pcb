(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 0.12)
  )

  (paper "A3")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
  )

  (setup
    (pad_to_mask_clearance 0.05)
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "VCC")
  (net 3 "DATA_IN")
  (net 4 "CLK_IN")

  ;; --- BOARD OUTLINE (10.0mm x 345.0mm with rounded tip) ---
  (gr_line (start 1.0 0) (end 9.0 0) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 9.0 0) (end 10.0 1.0) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 10.0 1.0) (end 10.0 340.0) (layer "Edge.Cuts") (width 0.1))
  (gr_arc (start 10.0 340.0) (mid 8.5 344.5) (end 5.0 345.0) (layer "Edge.Cuts") (width 0.1))
  (gr_arc (start 5.0 345.0) (mid 1.5 344.5) (end 0 340.0) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 0 340.0) (end 0 1.0) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 0 1.0) (end 1.0 0) (layer "Edge.Cuts") (width 0.1))

  ;; --- SILKSCREEN ---
  (gr_text "OPEN PIXEL 128-LED BLADE (2.5mm PITCH)" (at 5.0 25.0 90) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.12))))
  (gr_text "VCC  GND  DAT  CLK" (at 5.0 6.0) (layer "F.SilkS") (effects (font (size 0.6 0.6) (thickness 0.1))))
  (gr_text "TIP #128" (at 5.0 338.0) (layer "F.SilkS") (effects (font (size 0.6 0.6) (thickness 0.1))))

  ;; --- CONNECTOR CONTACT FINGERS (0.5mm pitch FPC tail or direct solder) ---
  (pad "1" smd rect (at 2.0 2.5) (size 0.8 4.0) (layers "F.Cu" "F.Mask") (net 2)) ;; VCC
  (pad "2" smd rect (at 4.0 2.5) (size 0.8 4.0) (layers "F.Cu" "F.Mask") (net 1)) ;; GND
  (pad "3" smd rect (at 6.0 2.5) (size 0.8 4.0) (layers "F.Cu" "F.Mask") (net 3)) ;; DATA
  (pad "4" smd rect (at 8.0 2.5) (size 0.8 4.0) (layers "F.Cu" "F.Mask") (net 4)) ;; CLK
)
